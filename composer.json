{
  "name": "dwenzel/be-environment-indicator",
  "description": "Shows the current environment (application context) and the admin role in the TYPO3 backend top bar.",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "keywords": [
    "TYPO3",
    "backend",
    "environment",
    "application context"
  ],
  "authors": [
    {
      "name": "Dirk Wenzel",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/dwenzel/be-environment-indicator",
  "support": {
    "issues": "https://github.com/dwenzel/be-environment-indicator/issues",
    "source": "https://github.com/dwenzel/be-environment-indicator"
  },
  "require": {
    "php": "^8.1",
    "typo3/cms-backend": "^11.5 || ^12.4 || ^13.4 || ^14.3",
    "typo3/cms-core": "^11.5 || ^12.4 || ^13.4 || ^14.3"
  },
  "require-dev": {
    "armin/editorconfig-cli": "^1.8 || ^2.0",
    "ergebnis/composer-normalize": "^2.28",
    "friendsofphp/php-cs-fixer": "^3.57",
    "phpstan/extension-installer": "^1.2",
    "phpstan/phpstan": "^1.10 || ^2.1",
    "phpunit/phpunit": "^9.6",
    "saschaegerer/phpstan-typo3": "^1.10 || ^2.0 || ^3.0",
    "ssch/typo3-rector": "^2.0 || ^3.0",
    "typo3/coding-standards": "^0.7.0 || ^0.8.0"
  },
  "autoload": {
    "psr-4": {
      "DWenzel\\BeEnvironmentIndicator\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DWenzel\\BeEnvironmentIndicator\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "bin-dir": ".build/bin",
    "policy": {
      "advisories": {
        "ignore": [
          "enshrined/svg-sanitize",
          "typo3/cms-backend",
          "typo3/cms-core",
          "typo3/cms-recordlist"
        ]
      }
    },
    "sort-packages": true,
    "vendor-dir": ".build/vendor"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "be_environment_indicator",
      "web-dir": ".build/Web"
    }
  },
  "scripts": {
    "fix": [
      "@fix:composer",
      "@fix:editorconfig",
      "@fix:php"
    ],
    "fix:composer": "@composer normalize",
    "fix:editorconfig": "ec --fix",
    "fix:php": "php-cs-fixer fix",
    "lint": [
      "@lint:composer",
      "@lint:editorconfig",
      "@lint:php"
    ],
    "lint:composer": "@composer normalize --dry-run",
    "lint:editorconfig": "ec",
    "lint:php": "php-cs-fixer fix --dry-run --diff",
    "migration": [
      "@migration:rector"
    ],
    "migration:rector": [
      "Composer\\Config::disableProcessTimeout",
      "rector process"
    ],
    "sca": [
      "@sca:php"
    ],
    "sca:php": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": [
      "@test:unit"
    ],
    "test:coverage": "XDEBUG_MODE=coverage phpunit -c Tests/Build/UnitTests.xml --coverage-text",
    "test:unit": "phpunit -c Tests/Build/UnitTests.xml"
  },
  "scripts-descriptions": {
    "fix": "Fix all code quality issues reported by the registered linters",
    "lint": "Run all registered linters to detect code quality issues",
    "migration": "Run all registered automatic code migrations",
    "sca": "Run all registered static code analyzers to detect issues in the codebase",
    "test": "Run all configured test suites",
    "test:coverage": "Generate code coverage report",
    "test:unit": "Run unit tests"
  }
}
